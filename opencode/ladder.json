{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ladder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "trained-assist llm-ladder",
      "options": {
        "baseURL": "https://llm-ladder.trainedassist.store/v1",
        "apiKey": "{env:LLM_LADDER_TOKEN}"
      },
      "models": {
        "deepseek": { "name": "deepseek ladder (Go -> OpenRouter)", "tool_call": true }
      }
    }
  },
  "permission": { "edit": "allow", "bash": "allow", "webfetch": "deny" }
}
